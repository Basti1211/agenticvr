FROM python:3.13-slim

# Avoid bytecode files and unbuffered logs in the container.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

USER 10001:10001
CMD ["gunicorn", "--config=gunicorn.conf.py", "-k", "uvicorn.workers.UvicornWorker", "application.main:app"]
