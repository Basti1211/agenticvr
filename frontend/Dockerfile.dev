FROM node:24-alpine

WORKDIR /app

# Copy the list of necessary dependencies
COPY package.json ./

# Install dependencies
RUN --mount=type=cache,target=/.yarn-cache,id=prak-vlm-yarn-cache yarn install --verbose --cache-folder /.yarn-cache --prefer-offline

# Do NOT copy the application files like COPY . .  - this MUST NOT be done as we map them on the fly and have file system conflicts otherwise (and duplicate files)

# Start the application and allow for connections from any host
CMD ["yarn", "run", "dev", "--host"]
